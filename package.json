{
  "name": "whisp",
  "version": "1.4.0",
  "description": "macOS voice dictation app using OpenAI Whisper",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "WHISP_DEV=1 electron .",
    "build": "electron-builder --mac",
    "pack": "electron-builder --mac --dir"
  },
  "author": "Moonsight",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0"
  },
  "build": {
    "appId": "com.moonsight.whisp",
    "productName": "Whisp",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Whisp needs microphone access to transcribe your speech.",
        "LSUIElement": true
      }
    }
  }
}
